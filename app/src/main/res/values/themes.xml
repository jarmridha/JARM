<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.JARM" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jarm_navy</item>
        <item name="android:statusBarColor">@color/jarm_navy</item>
        <item name="android:navigationBarColor">@color/jarm_navy</item>
    </style>

    <style name="Theme.JARM.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jarm_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.JARM</item>
    </style>
</resources>
