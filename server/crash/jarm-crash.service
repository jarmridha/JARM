[Unit]
Description=JARM anonymous crash-report receiver
After=network.target

[Service]
Type=simple
User=jarm
Group=jarm
ExecStart=/usr/bin/python3 /opt/jarm-crash/jarm-crash.py
Restart=on-failure
RestartSec=2

# Sandboxing — the service only needs to bind loopback and write its data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jarm-crash
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
